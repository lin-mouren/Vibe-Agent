generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeType {
  PROMPT
  RENDER_GRID
  SCENE_BOARD
  EXPORT
  ANALYSIS
}

enum ExecutionStatus {
  CREATED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum JobStatus {
  WAITING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELED
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  canvases  Canvas[]
}

model Canvas {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  viewport   Json
  version    Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  nodes      Node[]
  edges      Edge[]
  executions Execution[]
  exports    Export[]

  @@index([projectId])
}

model Node {
  id            String   @id @default(uuid()) @db.Uuid
  canvasId      String   @db.Uuid
  canvas        Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  type          NodeType
  pos           Json
  config        Json
  status        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fromEdges     Edge[]   @relation("FromNode")
  toEdges       Edge[]   @relation("ToNode")
  jobs          Job[]
  renders       Render[]
  rootExecutions Execution[] @relation("ExecutionRootNode")

  @@index([canvasId, type])
}

model Edge {
  id         String   @id @default(uuid()) @db.Uuid
  canvasId   String   @db.Uuid
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  fromNodeId String   @db.Uuid
  toNodeId   String   @db.Uuid
  fromNode   Node     @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode     Node     @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  type       String
  config     Json

  @@index([canvasId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model Execution {
  id          String          @id @default(uuid()) @db.Uuid
  canvasId    String          @db.Uuid
  canvas      Canvas          @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  mode        String
  rootNodeId  String?         @db.Uuid
  rootNode    Node?           @relation("ExecutionRootNode", fields: [rootNodeId], references: [id])
  status      ExecutionStatus
  requestedBy String
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  error       Json?
  jobs        Job[]
  renders     Render[]
  exports     Export[]

  @@index([canvasId])
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  executionId String    @db.Uuid
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String    @db.Uuid
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type        String
  status      JobStatus
  attempt     Int       @default(0)
  maxAttempt  Int       @default(3)
  payload     Json
  result      Json?
  error       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([executionId, nodeId])
  @@index([status, createdAt])
}

model Asset {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String
  mime       String
  storageKey String   @unique
  width      Int?
  height     Int?
  sha256     String
  meta       Json
  createdAt  DateTime @default(now())
  renders    Render[]
}

model Render {
  id             String    @id @default(uuid()) @db.Uuid
  nodeId         String    @db.Uuid
  node           Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  executionId    String    @db.Uuid
  execution      Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  assetId        String    @db.Uuid
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  gridIndex      Int
  promptSnapshot Json
  createdAt      DateTime  @default(now())

  @@unique([executionId, nodeId, gridIndex])
  @@index([nodeId])
}

model Export {
  id          String    @id @default(uuid()) @db.Uuid
  canvasId    String    @db.Uuid
  canvas      Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  executionId String?   @db.Uuid
  execution   Execution? @relation(fields: [executionId], references: [id])
  status      String
  storageKey  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([canvasId])
}
